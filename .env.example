# Required: set a long unique password; never commit your real .env
APP_PASSWORD=
# At least one provider is needed for monitoring
GPTUNNEL_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Optional, only if needed
APP_SECRET_KEY=
MAX_REQUESTS_PER_RUN=100
# For an HTTPS deployment set true; for local HTTP use false
SESSION_COOKIE_SECURE=false
# Enable only when behind a trusted reverse proxy
TRUST_PROXY=false
# Optional model overrides (uncomment and set model IDs from your account)
# CHATGPT_MODEL_ID=
# GEMINI_MODEL_ID=
# DEEPSEEK_MODEL_ID=
# QWEN_MODEL_ID=
# GIGACHAT_MODEL_ID=
# GPTUNNEL_SEARCH_MODEL_ID=
# YANDEX_MODEL_ID=
# YANDEX_INPUT_COST_PER_1000=
# YANDEX_OUTPUT_COST_PER_1000=
